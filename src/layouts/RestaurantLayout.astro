---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Analytics from '@vercel/analytics/astro';
import { calculateOverall, toLetterGrade } from '../utils/scoring';

type Props = CollectionEntry<'restaurants'>['data'];

const {
	name, category, visitDate, location, pricePerPerson,
	scores, comparedTo, comparisonResult,
	googleAtVisit, googleReviewCountAtVisit,
	googleNow, googleReviewCountNow, revisit, notes
} = Astro.props;

const overallScore = calculateOverall(scores);
const grade = toLetterGrade(overallScore);

const categoryMap: Record<string, string> = {
	'bufe': 'Büfe/Sokak', 'kafe': 'Kafe', 'kahvaltici': 'Kahvaltıcı',
	'lokanta': 'Lokanta', 'restoran': 'Restoran', 'fast-food': 'Fast-Food',
	'fine-dining': 'Fine-Dining', 'pastane-tatlici': 'Pastane'
};
const catLabel = categoryMap[category] || category;

function getBar(val: number) {
	const f = Math.round(val);
	return '■'.repeat(f) + '□'.repeat(10 - f);
}

const diffGoogle = (googleNow && googleAtVisit) ? (googleNow - googleAtVisit).toFixed(1) : null;
const isGoogleImproved = diffGoogle ? parseFloat(diffGoogle) > 0 : false;
---

<html lang="en">
	<head>
		<BaseHead title={`${name} - Eats Review`} description={`Review of ${name} (${category})`} />
		<style>
			:root {
				--eats-accent: #ff5a36;
				--eats-accent-light: #ffe8e3;
			}
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 2em 0;
			}
			.review-header {
				margin-bottom: 3em;
				border-bottom: 2px solid var(--eats-accent-light);
				padding-bottom: 2em;
			}
			.title-wrap {
				display: flex;
				align-items: baseline;
				gap: 0.5em;
				margin-bottom: 0.5em;
				flex-wrap: wrap;
			}
			.restaurant-name {
				font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
				font-size: 3em;
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.1;
			}
			.restaurant-grade {
				font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
				font-size: 2em;
				font-style: italic;
				color: var(--eats-accent);
				font-weight: 400;
			}
			.meta-line {
				font-size: 0.95em;
				color: rgb(var(--gray));
				margin: 0 0 2em 0;
			}
			
			/* Profile */
			.taste-profile {
				margin: 2em 0;
			}
			.taste-profile h3 {
				font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
				font-size: 1.2em;
				text-transform: uppercase;
				letter-spacing: 2px;
				color: rgb(var(--gray));
				margin-bottom: 1em;
				font-weight: 400;
			}
			.score-row {
				display: flex;
				align-items: center;
				margin-bottom: 0.5em;
				font-size: 0.95em;
			}
			.score-label {
				width: 140px;
				color: rgb(var(--black));
			}
			.score-label.primary {
				font-weight: bold;
				font-size: 1.1em;
			}
			.score-bar {
				flex: 1;
				color: var(--eats-accent);
				letter-spacing: 2px;
				font-family: monospace;
			}
			.score-num {
				width: 40px;
				text-align: right;
				font-weight: bold;
				color: rgb(var(--gray-dark));
			}

			.review-content {
				font-size: 1.1em;
				line-height: 1.8;
				color: rgb(var(--gray-dark));
				margin-bottom: 3em;
			}

			.inline-details {
				border-top: 1px solid #eaeaea;
				padding-top: 2em;
				font-size: 0.9em;
				color: rgb(var(--gray-dark));
			}
			.inline-details ul {
				list-style-type: none;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 1em;
			}
			.inline-details li {
				margin-bottom: 0.5em;
			}
			.inline-details strong {
				color: rgb(var(--black));
				font-weight: 600;
			}
			.google-trend.up { color: #10b981; }
			.google-trend.down { color: #ef4444; }
			
			@media (max-width: 600px) {
				.score-row {
					flex-direction: column;
					align-items: flex-start;
					margin-bottom: 1em;
				}
				.score-num {
					display: none;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="review-header">
					<div class="title-wrap">
						<h1 class="restaurant-name">{name}</h1>
						<span class="restaurant-grade">{grade}</span>
					</div>
					<p class="meta-line">
						{catLabel} &nbsp;&mdash;&nbsp; 📍 {location} &nbsp;&mdash;&nbsp; 📅 Ziyaret: <FormattedDate date={visitDate} />
					</p>

					<div class="taste-profile">
						<h3>Lezzet Profili</h3>
						<div class="score-row"><div class="score-label primary">Lezzet (%35)</div><div class="score-bar">{getBar(scores.lezzet)}</div><div class="score-num">{scores.lezzet}</div></div>
						<div class="score-row"><div class="score-label">Malzeme (%15)</div><div class="score-bar">{getBar(scores.malzeme)}</div><div class="score-num">{scores.malzeme}</div></div>
						<div class="score-row"><div class="score-label">Servis (%15)</div><div class="score-bar">{getBar(scores.servis)}</div><div class="score-num">{scores.servis}</div></div>
						<div class="score-row"><div class="score-label">Fiyat/Perf. (%15)</div><div class="score-bar">{getBar(scores.fiyatPerformans)}</div><div class="score-num">{scores.fiyatPerformans}</div></div>
						<div class="score-row"><div class="score-label">Ortam (%10)</div><div class="score-bar">{getBar(scores.ortam)}</div><div class="score-num">{scores.ortam}</div></div>
						<div class="score-row"><div class="score-label">Porsiyon (%10)</div><div class="score-bar">{getBar(scores.porsiyon)}</div><div class="score-num">{scores.porsiyon}</div></div>
					</div>
				</div>

				<div class="review-content prose">
					<slot />
				</div>

				<div class="inline-details">
					<ul>
						{pricePerPerson && <li><strong>Hesap:</strong> ~{pricePerPerson} ₺ / Kişi</li>}
						<li><strong>Tekrar Gidilir mi?:</strong> {revisit ? 'Kesinlikle' : 'Pek sanmıyorum'}</li>
						{googleNow && 
							<li>
								<strong>Google Puanı:</strong> {googleAtVisit} ➔ {googleNow} 
								{diffGoogle && diffGoogle !== "0.0" && (
									<span class={`google-trend ${isGoogleImproved ? 'up' : 'down'}`}>
										({isGoogleImproved ? '+' : ''}{diffGoogle})
									</span>
								)}
							</li>
						}
						{comparedTo && <li><strong>Kıyasla:</strong> {comparedTo} ({comparisonResult})</li>}
					</ul>
					{notes && <p style="margin-top: 1.5em; font-style: italic;"><strong>Notlar:</strong> {notes}</p>}
				</div>
			</article>
		</main>
		<Footer />
		<Analytics />
	</body>
</html>
