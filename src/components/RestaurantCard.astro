---
import type { CollectionEntry } from 'astro:content';
import { calculateOverall, toLetterGrade } from '../utils/scoring';

interface Props {
	restaurant: CollectionEntry<'restaurants'>;
}

const { restaurant } = Astro.props;
const { data, id } = restaurant;
const { name, category, location, scores } = data;

const overallScore = calculateOverall(scores);
const grade = toLetterGrade(overallScore);

const categoryMap: Record<string, string> = {
	'bufe': 'Büfe/Sokak', 'kafe': 'Kafe', 'kahvaltici': 'Kahvaltıcı',
	'lokanta': 'Lokanta', 'restoran': 'Restoran', 'fast-food': 'Fast-Food',
	'fine-dining': 'Fine-Dining', 'pastane-tatlici': 'Pastane'
};
const catLabel = categoryMap[category] || category;

const fillCount = Math.round(overallScore);
const progress = '■'.repeat(fillCount) + '□'.repeat(10 - fillCount);
---

<a href={`/eats/${id}/`} class="card">
	<div class="card-content">
		<h3 class="title">{name} <span class="grade">({grade})</span></h3>
		<p class="meta">{catLabel} &mdash; {location}</p>
		
		<div class="score-line">
			<span class="bar">{progress}</span>
			<span class="num">{overallScore}/10</span>
		</div>
	</div>
</a>

<style>
	.card {
		display: block;
		padding: 1.5em 0;
		text-decoration: none;
		color: var(--black);
		border-bottom: 1px solid rgba(var(--gray-light), 0.8);
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
	.card:hover {
		opacity: 0.7;
		transform: translateX(4px);
	}
	.title {
		font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
		margin: 0 0 0.2em 0;
		font-size: 1.6em;
		color: rgb(var(--black));
		display: flex;
		align-items: baseline;
		gap: 0.3em;
	}
	.grade {
		font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
		font-style: italic;
		color: #ff5a36;
		font-size: 0.8em;
		font-weight: 400;
	}
	.meta {
		font-size: 0.9em;
		color: rgb(var(--gray));
		margin: 0 0 1em 0;
	}
	.score-line {
		display: flex;
		align-items: center;
		gap: 0.8em;
		font-size: 0.85em;
		color: #ff5a36;
	}
	.bar {
		letter-spacing: 1px;
	}
	.num {
		font-weight: bold;
		color: rgb(var(--gray-dark));
	}
</style>
